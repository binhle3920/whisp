WHISP_OPENROUTER_API_KEY=
WHISP_OPENROUTER_MODEL=openai/gpt-5.4-nano
WHISP_TELEGRAM_BOT_TOKEN=
WHISP_TELEGRAM_CHAT_ID=

# File-based credentials live here. See docs/inputs/gmail.md.
WHISP_CREDENTIALS_DIR=./credentials

# Database and polling settings
WHISP_DB_PATH=./data/whisp.db
WHISP_POLL_INTERVAL_SECONDS=60
WHISP_MAX_MESSAGES_PER_RUN=25
WHISP_EMAIL_MAX_CHARS=12000
WHISP_POLLER_ENABLED=true
WHISP_LOG_LEVEL=INFO
