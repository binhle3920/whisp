# Whisp on a domain. install-domain.sh replaces __DOMAIN__, then certbot adds the HTTPS
# server block and the HTTP-to-HTTPS redirect to this file.
# Requires whisp-ratelimit.conf in /etc/nginx/conf.d for the whisp_dashboard zone.
server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    location = /healthz {
        proxy_pass http://127.0.0.1:8080/healthz;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        access_log off;
    }

    # The dashboard and its login form (/dashboard/login, /dashboard/logout). Whisp
    # checks WHISP_DASHBOARD_USERNAME/PASSWORD; the rate limit slows password guessing.
    location /dashboard {
        limit_req zone=whisp_dashboard burst=10 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        add_header X-Robots-Tag "noindex, nofollow" always;
    }

    # Only Telegram's published webhook ranges may reach the bot. Whisp also checks the
    # X-Telegram-Bot-Api-Secret-Token header, so this is defense in depth.
    location = /telegram/webhook {
        allow 149.154.160.0/20;
        allow 91.108.4.0/22;
        deny all;
        proxy_pass http://127.0.0.1:8080/telegram/webhook;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    # The public landing page. Exact match, so every other path still returns 404.
    location = / {
        proxy_pass http://127.0.0.1:8080/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    location / {
        return 404;
    }
}
