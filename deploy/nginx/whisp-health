# Plain-HTTP site for the bare IP: only the health check. The dashboard is served by the
# HTTPS domain site (whisp-domain) because its login must not travel unencrypted.
server {
    listen 80;
    listen [::]:80;
    server_name 159.198.66.238;

    location = /healthz {
        proxy_pass http://127.0.0.1:8080/healthz;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        access_log off;
    }

    location / {
        return 404;
    }
}
